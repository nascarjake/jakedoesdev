{
  "name": "jacob-clark-developer-universe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "next build --webpack",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "worklog": "node scripts/worklog.mjs",
    "worklog:sync": "node scripts/sync-worklog-review.mjs",
    "updates:sync": "node scripts/sync-approved-updates.mjs",
    "test": "npm run build:pages && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "db:generate": "drizzle-kit generate",
    "db:seed-sql": "node scripts/generate-portfolio-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply jakedoesdev-portfolio --local",
    "db:migrate:remote": "node scripts/verify-cloudflare-account.mjs && wrangler d1 migrations apply jakedoesdev-portfolio --remote --profile jakedoesdev-personal"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.141.0"
  },
  "type": "module"
}
